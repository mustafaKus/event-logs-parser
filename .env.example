# Copy to .env and edit. Never commit .env.

# --- Event parser app --------------------------------------------------------
# Path to the canonical event catalog (YAML).
EVENT_PARSER_CONFIG=config/events.yaml

# Directory root for per-customer JSONL storage (parsers, events, quarantine, clusters).
EVENT_PARSER_STORAGE=storage

# LLM backend: "mock" (offline, default) or "openai" (uses OpenAI Agents SDK).
EVENT_PARSER_LLM=openai

# Model id passed to the OpenAI Agents SDK when EVENT_PARSER_LLM=openai.
# Confirm against current OpenAI docs before assuming availability.
EVENT_PARSER_MODEL=gpt-4.1-mini

# Required only when EVENT_PARSER_LLM=openai. Leave blank for the mock path.
OPENAI_API_KEY=

# --- Flask -------------------------------------------------------------------
FLASK_HOST=0.0.0.0
FLASK_PORT=5001
FLASK_DEBUG=1
